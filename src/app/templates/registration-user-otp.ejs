<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email - FixFlow</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background: #f4f7fb;
      font-family: Arial, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding: 40px 20px">
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            style="
              background: #ffffff;
              border-radius: 12px;
              padding: 40px;
              max-width: 600px;
            "
          >
            <!-- Logo / Brand -->
            <tr>
              <td align="center">
                <h1
                  style="
                    color: #2563eb;
                    margin: 0;
                    font-size: 30px;
                  "
                >
                  FixFlow
                </h1>

                <p
                  style="
                    color: #64748b;
                    margin-top: 8px;
                    font-size: 14px;
                  "
                >
                  Field Service Management System
                </p>
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td align="center" style="padding-top: 25px">
                <h2 style="color: #1e293b; margin: 0">
                  Verify Your Email Address
                </h2>
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding-top: 25px; color: #334155">
                <p>
                  Hi <strong><%= name %></strong>,
                </p>

                <p>
                  Welcome to <strong>FixFlow</strong>! We're excited to have
                  you with us.
                </p>

                <p>
                  Please use the verification code below to verify your email
                  address and activate your account.
                </p>

                <!-- OTP -->
                <div style="text-align: center; margin: 35px 0">
                  <span
                    style="
                      display: inline-block;
                      background: #2563eb;
                      color: #ffffff;
                      padding: 16px 32px;
                      font-size: 30px;
                      font-weight: bold;
                      border-radius: 8px;
                      letter-spacing: 8px;
                    "
                  >
                    <%= otp %>
                  </span>
                </div>

                <p>
                  This verification code will expire in
                  <strong><%= expirationMinutes %> minutes</strong>.
                </p>

                <p>
                  For your security, please do not share this code with anyone.
                </p>

                <p>
                  If you didn't create a FixFlow account, you can safely ignore
                  this email.
                </p>

                <hr
                  style="
                    margin: 30px 0;
                    border: none;
                    border-top: 1px solid #e2e8f0;
                  "
                />

                <!-- Footer -->
                <p
                  style="
                    color: #94a3b8;
                    font-size: 12px;
                    text-align: center;
                  "
                >
                  © <%=  %> FixFlow. All rights reserved.
                </p>

                <p
                  style="
                    color: #94a3b8;
                    font-size: 12px;
                    text-align: center;
                  "
                >
                  Simplifying your field service experience.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>